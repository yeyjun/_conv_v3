<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiRemoteController.Pages.AddEditTerminalPage"
             Title="Add Terminal">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Name" FontAttributes="Bold" />
            <Entry x:Name="NameEntry" Placeholder="e.g. Front Counter" />

            <Label Text="Host" FontAttributes="Bold" />
            <Entry x:Name="HostEntry" Placeholder="LAN IP or public hostname" Keyboard="Url" />

            <Label Text="Port" FontAttributes="Bold" />
            <Entry x:Name="PortEntry" Text="51820" Keyboard="Numeric" />

            <Label Text="Token" FontAttributes="Bold" />
            <Entry x:Name="TokenEntry"
                   Placeholder="REMOTE_CONTROL_TOKEN configured on that terminal"
                   IsPassword="True" />

            <BoxView HeightRequest="1" Color="#33808080" Margin="0,8" />

            <Label Text="Certificate trust" FontAttributes="Bold" />
            <Label x:Name="ThumbprintLabel"
                   Text="Not trusted yet - test the connection before saving."
                   FontSize="12"
                   LineBreakMode="WordWrap" />
            <Button x:Name="TestButton"
                    Text="Test Connection &amp; Trust Certificate"
                    Clicked="OnTestConnectionClicked" />

            <BoxView HeightRequest="1" Color="#33808080" Margin="0,8" />

            <Button Text="Save" Clicked="OnSaveClicked" />
            <Button x:Name="DeleteButton"
                    Text="Delete Terminal"
                    IsVisible="False"
                    BackgroundColor="#C0392B"
                    TextColor="White"
                    Clicked="OnDeleteClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
